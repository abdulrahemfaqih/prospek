# ==========================================================
# PROSPEK WEB DASHBOARD (.env.local)
# Salin file ini menjadi .env.local untuk lingkungan lokal
# dan daftarkan di Environment Variables Vercel saat deploy.
# ==========================================================

# URL Proyek Supabase (dapat diakses browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Kunci Anon Publik Supabase (dapat diakses browser dengan proteksi RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Kunci Service Role Supabase (HANYA digunakan di server Next.js untuk cron keepalive)
# PERINGATAN: JANGAN beri awalan NEXT_PUBLIC_! Kunci ini mem-bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Rahasia Bearer token untuk mengamankan route /api/cron/keepalive
CRON_SECRET=your-secure-random-cron-secret-here
