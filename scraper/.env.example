# Kunci API SerpApi (ambil dari serpapi.com/manage-api-key)
SERPAPI_API_KEY=5d91be540a85e6a8bad5740f81cab06d087c4c6cf73f8e460ba13ce914fee18e

# URL Proyek Supabase
SUPABASE_URL=https://your-project-ref.supabase.co

# Kunci Service Role Supabase (dibutuhkan agar scraper dapat menulis data langsung)
# JANGAN pernah bagikan atau commit kunci ini ke repository publik!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
